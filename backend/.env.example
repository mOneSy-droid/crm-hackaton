# ---------------------------------------------------------------------------
# Nusxa ol:  cp .env.example .env    (Windows: copy .env.example .env)
# Railway'da bularni Variables bo'limiga qo'yasan.
# ---------------------------------------------------------------------------

ENV=dev

# JWT va umumiy imzolash uchun. Productionda ALBATTA o'zgartir:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-change-me-please-at-least-32-characters

# Telegram bot <-> backend o'rtasidagi HMAC imzo uchun umumiy kalit.
# Bot komandasiga SHU qiymatni berasan (boshqa hech kimga emas).
BOT_HMAC_SECRET=dev-only-bot-shared-secret-change-me

# Restoranlarning shaxsiy bot tokenlarini shifrlash uchun Fernet kaliti.
# Bo'sh qoldirsang SECRET_KEY dan avtomatik hosil qilinadi (dev uchun yetarli).
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Lokalda SQLite, Railway'da Postgres URL avtomatik keladi (DATABASE_URL).
DATABASE_URL=sqlite+aiosqlite:///./restaurant_crm.db

# Vercel'dagi frontend manzili + lokal dev.
# Frontend dev serveri 8080-portda ishlaydi (TanStack Start).
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
FRONTEND_URL=http://localhost:8080

# Backendning o'z tashqi manzili (rasm URL'larini yasash uchun)
PUBLIC_BASE_URL=http://localhost:8000

MEDIA_ROOT=./media

# Ixtiyoriy: BotBuilder anketasidan bot logikasini generatsiya qilish uchun
ANTHROPIC_API_KEY=
