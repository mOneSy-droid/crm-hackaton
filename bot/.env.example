# ---------------------------------------------------------------------------
# copy .env.example .env
# Railway'da bularni Variables bo'limiga qo'yasan.
# ---------------------------------------------------------------------------

# @BotFather bergan token. HECH QACHON repoga commit qilinmasin.
TELEGRAM_BOT_TOKEN=

# Backend manzili (Railway'dagi backend servisi)
CRM_API_URL=http://localhost:8000

# Backenddagi BOT_HMAC_SECRET bilan AYNAN bir xil bo'lishi shart
BOT_HMAC_SECRET=dev-only-bot-shared-secret-change-me

# Botning o'z bazasi: til tanlovi va adminlar.
# Railway'da Postgres qo'shsang DATABASE_URL avtomatik keladi.
BOT_DATABASE_URL=sqlite+aiosqlite:///./bot.db

# Vergul bilan ajratilgan Telegram user ID lar — bular doim admin bo'ladi.
# O'z ID'ingizni bilish uchun: @userinfobot ga yozing.
BOT_SUPER_ADMINS=

# Backend bildirishnomalarini necha soniyada bir tekshirish
OUTBOX_POLL_SECONDS=5
